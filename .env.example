# Copy this file to .env and edit as needed. .env is gitignored (it's
# environment-specific -- BLE address, serial ports) and is read by both
# ./run.sh and the systemd service in deploy/.

# Real CU hardware: a serial path, a BLE MAC/UUID, or "auto" to scan for
# a device named Control_Unit each startup. Leave unset/commented to run
# against the built-in mock CU (six simulated cars, no hardware needed).
#CARRERA_RMS_CU_DEVICE=auto

# Only set this once you're specifically testing whether writing speed/
# brake to controller addresses 0-5 does anything on your hardware --
# see app/cu/carreralib_client.py's module docstring. Leave unset/0 by
# default.
#CARRERA_RMS_CU_ALLOW_CONTROLLER_WRITES=1

# Arduino serial bridge (fuel/pit panel, start lights, etc.) -- see
# app/network/arduino_api.py and arduino/ for the protocol and examples.
#CARRERA_RMS_ARDUINO_PORT=/dev/ttyACM0
